{
  "name": "promeos-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "optimize-images": "node scripts/optimize-images.js",
    "lint:js": "eslint . --ext .js,.html || true",
    "lint:css": "stylelint \"css/**/*.css\" || true",
    "lint": "npm run lint:js && npm run lint:css",
    "serve": "http-server . -c-1 -p 8080",
    "lighthouse": "lhci autorun --upload.target=temporary-public-storage"
  },
  "devDependencies": {
    "@lhci/cli": "^0.10.0",
    "http-server": "^14.1.1",
    "sharp": "^0.32.0",
    "eslint": "^8.0.0",
    "stylelint": "^14.0.0"
  }
}
